# Kopirajte to datoteko v .env in vpišite svoj ključ.
# Datoteka .env je v .gitignore in NE gre na GitHub.

# Ključ za xAI Grok (https://console.x.ai) – osumljence igra Grok
XAI_API_KEY=vas-kljuc-tukaj
XAI_MODEL=grok-4.7

# Neobvezno: namesto Groka lahko uporabite Claude (uporabi se le, če XAI_API_KEY ni nastavljen)
# ANTHROPIC_API_KEY=vas-kljuc-tukaj
# AI_MODEL=claude-opus-5-5

# Največ sekund čakanja na odgovor AI
AI_CASOVNA_OMEJITEV=30
