# Kopirajte to datoteko v .env in vpišite svoj ključ.
# Datoteka .env je v .gitignore in NE gre na GitHub.

# Ponudnik:
#   auto      – pravi AI, če je spodaj vpisan ključ, sicer demo (privzeto)
#   anthropic – vedno pravi AI
#   demo      – brez interneta, vnaprej pripravljeni odgovori
AI_PONUDNIK=auto

# Ključ za Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=vas-kljuc-tukaj

# Ime modela
AI_MODEL=claude-opus-5-5

# Največ sekund čakanja na odgovor AI
AI_CASOVNA_OMEJITEV=30
