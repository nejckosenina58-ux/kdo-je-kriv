# Kopirajte to datoteko v .env in vpišite svoj ključ.
# Datoteka .env je v .gitignore in NE gre na GitHub.

# Ključ za Google Gemini (https://aistudio.google.com/apikey) – brezplačen paket
GEMINI_API_KEY=vas-kljuc-tukaj
GEMINI_MODEL=gemini-flash-latest

# Neobvezno: namesto Geminija lahko uporabite Grok ali Claude
# (uporabi se prvi nastavljen ključ v vrstnem redu Gemini, Grok, Claude)
# XAI_API_KEY=vas-kljuc-tukaj
# XAI_MODEL=grok-4.7
# ANTHROPIC_API_KEY=vas-kljuc-tukaj
# AI_MODEL=claude-opus-5-5

# Največ sekund čakanja na odgovor AI
AI_CASOVNA_OMEJITEV=60
